MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database
JWT_SECRET=replace-with-a-long-random-secret
SYSTEM_ANNUAL_INTEREST_RATE=12

# Paypack mobile-money deposits
PAYPACK_CLIENT_ID=your-paypack-application-client-id
PAYPACK_CLIENT_SECRET=your-paypack-application-client-secret
PAYPACK_WEBHOOK_SECRET=your-paypack-webhook-signing-secret
PAYPACK_ENVIRONMENT=development

# SMTP settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=your-sender@example.com

